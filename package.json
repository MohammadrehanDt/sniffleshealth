{
  "name": "sniffleshealth-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo run dev --filter=@sniffles/web",
    "dev:api": "turbo run dev --filter=@sniffles/api",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prisma:generate": "turbo run prisma:generate --filter=@sniffles/api",
    "prisma:migrate:dev": "turbo run prisma:migrate:dev --filter=@sniffles/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "packageManager": "pnpm@10.14.0"
}
