{
  "name": "sniffleshealth-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @sniffles/web dev",
    "dev:api": "pnpm --filter @sniffles/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "db:generate": "pnpm --filter @sniffles/api prisma:generate",
    "db:migrate": "pnpm --filter @sniffles/api prisma:migrate:dev",
    "db:push": "pnpm --filter @sniffles/api exec prisma db push && pnpm run db:generate",
    "db:studio": "pnpm --filter @sniffles/api exec prisma studio",
    "db:deploy": "pnpm --filter @sniffles/api exec prisma migrate deploy && pnpm run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "packageManager": "pnpm@10.14.0"
}
