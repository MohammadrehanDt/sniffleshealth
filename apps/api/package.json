    "@nestjs/platform-express": "^11.1.8",
    "@prisma/client": "^6.7.0",
    "@sniffles/types": "workspace:*",
    "@sniffles/utils": "workspace:*",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
