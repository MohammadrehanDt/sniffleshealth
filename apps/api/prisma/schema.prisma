generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  fullName        String?
  role            UserRole
  npiNumber       String?
  phone           String?
  dateOfBirth     DateTime?
  weight          Float?
  weightUnit      String?   @default("kg")
  height          Float?
  heightUnit      String?   @default("ft")
  avatarUrl       String?
  healthiePatientId String?   @unique
  healthieProviderId String?  @unique
  passwordHash              String?
  otpCode                   String?
  otpExpiresAt              DateTime?
  resetPasswordTokenHash    String?
  resetPasswordTokenExpiresAt DateTime?
  emailVerifiedAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses               Address[]
  consultationsAsPatient  Consultation[] @relation("PatientConsultations")
  consultationsAsDoctor   Consultation[] @relation("DoctorConsultations")
}

model Address {
  id              String    @id @default(cuid())
  userId          String
  label           String
  addressLine1    String
  addressLine2    String?
  state           String
  city            String
  zipCode         String
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ConsultationStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Consultation {
  id                String             @id @default(cuid())
  patientId         String
  doctorId          String?
  healthieRequestedPaymentId String?   @unique
  paymentStatus     String?
  paymentAmount     String?
  firstName         String
  lastName          String
  state             String
  dob               String
  gender            String
  severity          Int
  consultationType  String
  status            ConsultationStatus @default(PENDING)
  symptoms          Json
  followUp          Json
  vitals            Json
  medicalHistory    Json
  surgicalHistory   Json
  allergies         Json
  medications       Json
  socialHistory     Json
  soapNote          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  patient           User               @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Restrict)
  doctor            User?              @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([state])
}
